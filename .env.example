# Copy to .env.local and fill in.

# Supabase. Both values are safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Razorpay. Server-side only — no NEXT_PUBLIC_ prefix on either.
# The key id is sent to the browser by the checkout action, which is how
# Razorpay's widget identifies the merchant; the secret never leaves the server
# and is what signs and verifies payments. Leave both empty to run the shop in
# demonstration mode (Site settings → Selling).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
